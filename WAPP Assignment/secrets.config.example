<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to secrets.config (same folder) and fill in your own n8n values.
     secrets.config is git-ignored. Leave values empty to run without AI features. -->
<appSettings>
  <add key="N8nEssayWebhookUrl" value="https://YOUR-N8N-HOST/webhook/sea-essay-grade" />
  <add key="N8nHintWebhookUrl" value="https://YOUR-N8N-HOST/webhook/sea-hint" />
  <add key="N8nAuthToken" value="" />
</appSettings>
